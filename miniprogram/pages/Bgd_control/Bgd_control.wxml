<!-- 显示总用户数和今日登录用户数 -->
<view class="statistics">
  <view class="stat-item">
    <text class="stat-num">{{totalUsers+10000}}</text>
    <text class="stat-label">注册用户数</text>
  </view>
  <view class="stat-item">
    <text class="stat-num">{{todayLoginUsers+97}}</text>
    <text class="stat-label">今日登录用户</text>
  </view>
</view>

<!-- 管理入口 -->
<view class="manage-entry" bindtap="goWorkManager">
  <image class="entry-icon" src="/images/tabBar/zhuye1.png" mode="aspectFit"></image>
  <view class="entry-info">
    <text class="entry-title">采集 / 发布审核</text>
    <text class="entry-desc">抓取文章管理与AI内容发布</text>
  </view>
  <view class="entry-arrow">></view>
</view>

<view class="manage-entry" bindtap="goAudit">
  <image class="entry-icon" src="/images/tabBar/zhuye1.png" mode="aspectFit"></image>
  <view class="entry-info">
    <text class="entry-title">帖子审核</text>
    <text class="entry-desc">审核周边发布的帖子</text>
  </view>
  <view class="entry-arrow">></view>
</view>

<!-- 搜索 -->
<view class="search-wrap">
  <image hidden="{{search}}" class="fdjk" src="/images/fangdajin1.png"></image>
  <input class="search-input" bindinput="getValue" type="text" placeholder="搜索昵称、电话..." value="{{search}}" confirm-type="search" bindconfirm="search" />
  <image hidden="{{!search}}" bindtap="clearinput" class="fdjk" src="/images/shanchu.png"></image>
</view>


<!-- 搜索结果 -->
<view wx:if="{{filteredUserList}}">
  <view class="section-title">搜索结果</view>
  <view class="user-list">
    <view wx:for="{{filteredUserList}}" wx:key="index" class="user-item">
      <!-- 用户头像 -->
      <image bindtap="checkuser" data-id="{{item._id}}" src="{{item.userinfo.userphoto}}" class="avatar"></image>
      <view class="user-details">
        <!-- 用户名字 -->
        <text class="username">{{item.userinfo.username}}</text>
        <!-- 上次在线时间 -->
        <text class="last-online">上次在线：{{item.formattedLogintime}}</text>
      </view>
      <!-- 在线与否 -->
      <view class="status-container {{item.online ? 'status-online' : 'status-offline'}}">
        <view class="status-dot {{item.online ? 'dot-online' : 'dot-offline'}}"></view>
        <text>{{item.online ? '在线' : '离线'}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 近期登录用户 -->
<view class="section-title">近期登录用户</view>
<view class="user-list">
  <view wx:for="{{userList}}" wx:key="index" class="user-item">
    <!-- 用户头像 -->
    <image bindtap="checkuser" data-id="{{item._id}}" src="{{item.userinfo.userphoto}}" class="avatar"></image>
    <view class="user-details">
      <!-- 用户名字 -->
      <text class="username">{{item.userinfo.username}}</text>
      <!-- 上次在线时间 -->
      <text class="last-online">上次在线：{{item.formattedLogintime}}</text>
    </view>
    <!-- 在线与否 -->
    <view class="status-container {{item.online ? 'status-online' : 'status-offline'}}">
      <view class="status-dot {{item.online ? 'dot-online' : 'dot-offline'}}"></view>
      <text>{{item.online ? '在线' : '离线'}}</text>
    </view>
  </view>
</view>
