/**index.wxss**/
page {
  background-color: #f5f5f5;
  overflow-x: hidden;
  width: 100%;
}



.container {
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* Search Bar */
.search-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
}

.search-input-wrap {
  flex: 1;
  height: 70rpx;
  background-color: #f5f5f5;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  margin-right: 20rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
  margin-left: 10rpx;
}

.search-icons {
  display: flex;
  align-items: center;
}

.icon-circle {
  width: 60rpx;
  height: 60rpx;
  border: 1px solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  font-size: 30rpx;
  color: #333;
}

/* Sticky Header */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #fff;
  width: 100%;
}

/* Banner */
.swiper_wrapper {
  width: 95%;
  height: 120rpx;
  margin: 15rpx auto;
  border-radius: 15rpx;
  overflow: hidden;
}

.slide_image {
  width: 100%;
  height: 100%;
}

/* Module Navigation */
.module-nav {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  padding: 20rpx 0;
  margin-bottom: 2rpx;
}

.module-item {
  font-size: 30rpx;
  color: #666;
  font-weight: bold;
  position: relative;
  padding-bottom: 10rpx;
}

.module-item.active {
  color: #333;
  font-size: 32rpx;
}

.module-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 6rpx;
  background-color: #384f8f; /* Theme color */
  border-radius: 3rpx;
}

/* Tab Bar */
.tab-view {
  width: 100%;
  height: 80rpx;
  padding: 10rpx;
  background-color: rgb(255, 255, 255);
  white-space: nowrap; /* Allow horizontal scroll */
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 99;
  box-sizing: border-box;
}

.tab-bar-item {
  
  background-color: rgb(233, 233, 233);

border-radius: 10rpx;
  display: inline-block; /* Required for horizontal scroll */
  padding: 0 30rpx;
margin: 0 10rpx; 
  height: 60rpx;
  line-height: 60rpx;
  position: relative;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.tab-bar-item.active {
border-radius: 10rpx;
  background-color: rgb(233, 233, 233);
  color: #333;
  font-weight: bold;
  font-size: 30rpx;
}

.tab-line {
  position: absolute;


  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  /* background-color: #ffcc00;  */
  border-radius: 3rpx;
}

/* Content Area */
.tab-content {
  padding-top: 20rpx;
  min-height: 100vh;
}

.scoll-y {
  /* Removed min-height here as it's governed by content now, or we keep it if wrapper needs it */
  /* But strictly, if we want content to fill, tab-content handles it. */
  height: auto;
  min-height: 100%;
}

/* Grid Layout */
.grid-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 20rpx;
}

/* Card Style */
.card-item {
  width: 49%;
  background-color: #fff;
  border-radius: 15rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
}

.card-img-box {
  width: 100%;
  height: 200rpx; /* Fixed height for uniformity */
  background-color: #eee;
  position: relative;
}

.card-img {
  width: 100%;
  height: 100%;
}

.card-info {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
}

.card-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 10rpx;
  font-weight: bold;
  
  /* Multi-line ellipsis */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* Address */
.card-address {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #999;
  /* margin-bottom: 8rpx; */
  /* Truncation */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.address-icon {
  width: 20rpx;
  height: 18rpx;
  margin-right: 3rpx;
  flex-shrink: 0; /* Prevent icon from shrinking */
}

/* Stars */
.stars {
  display: flex;
  align-items: center;
  /* margin-bottom: 10rpx; Removed margin */
}

.star {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
}

.star view.icon_red {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 99;
  height: 24rpx;
  overflow: hidden;
}

.star view.icon_grey {
  position: absolute;
  left: 0;
  top: 0;
  width: 24rpx;
  height: 24rpx;
}

.star view image {
  width: 24rpx;
  height: 24rpx;
  display: block;
}

.score-text {
  font-size: 22rpx;
  color: #ff9900;
  margin-left: 10rpx;
}


.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto; /* Push to bottom */
}

/* Price styles removed */

.like-box {
  display: flex;
  align-items: center;
}

.cart-icon {
  width: 36rpx;
  height: 36rpx;
}

.like-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 6rpx;
}

/* Loading */
.juzho {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  pointer-events: none; /* Allow clicks to pass through if hidden */
}

.load_circle1 {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #fff;
}



/* Filter Bar */
.filter-bar {
  display: flex;
  height: 60rpx;
  padding: 10rpx 0 15rpx 10rpx;
  background-color: rgb(255, 255, 255);
  border-bottom: 1rpx solid #f5f5f5;
  align-items: center;
  justify-content: space-around;
  box-sizing: border-box;
}

.filter-item {
  font-size: 25rpx;
  color: rgb(173, 173, 173);
  padding: 13rpx 0;
  height: 100%;
  flex: 1; /* Distribute space equally */
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.filter-item.active {
border-radius: 20rpx;
  color: rgb(66, 66, 66);
  font-weight: bold;
}

.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 5rpx;
  background-color: #ff7300; 
  border-radius: 2rpx;
}

.sort-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
}


/* 发布弹窗 */

.publish-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.publish-options {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-top: 60rpx;
  margin-bottom: 50rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.publish-option-icon-bg {
  background-color: #ffffff;
  border-radius: 60rpx;
  width: 120rpx;
  height: 120rpx;
}

.publish-option-icon {
  border-radius: 60rpx;
  width: 120rpx;
  height: 120rpx;
}

.publish-option-text {
  margin-top: 5rpx;
  text-align: center;
  color: #2139a3;
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 0; /* Reset previous margin */
}

.publish-close-btn {
  background-color: #ff7300;
  border-radius: 50%;
  width: 100rpx;
  height: 100rpx;
  margin-block-end: 50rpx; /* Add some bottom margin */
  margin-left: 0; /* Reset previous margin */
  transition: transform 0.3s;
}

.publish-close-icon {
  width: 100rpx;
  height: 100rpx;
}

/* Bottom Loading Animation */
.bottom-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
  width: 100%;
}

.bottom-loading-img {
  width: 40rpx;
  height: auto;
}

/* Floating Button Styles */
.add-btn-container {
  position: relative;
  z-index: 1000;
}

.movable-area {
  width: 720rpx;
  position: fixed;
  top: 15rpx;
  left: 15rpx;
  pointer-events: none;
}

.movable-view {
  width: 100rpx;
  transition: height 0.3s;
  border-radius: 50rpx;
  pointer-events: auto;
  background-color: rgb(0, 38, 255);
  box-shadow: 0 4rpx 8rpx 0 rgba(0, 47, 255, 0.411);
}

.goTop {
  height: 100rpx;
  width: 100rpx;
  border-radius: 50%;
  opacity: 0.6;
}

.moveview {
  /* Ensure this class matches index behavior if needed, 
     though movable-view class already covers most styles. 
     Keeping it separate if additional specific styles are needed. */
}