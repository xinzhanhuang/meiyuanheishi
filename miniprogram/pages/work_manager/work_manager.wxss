/* Page Background */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f7f8fa; /* Light clean gray */
}

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 32rpx;
  box-shadow: 0 1rpx 0 rgba(0,0,0,0.05);
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #888;
  position: relative;
  transition: all 0.3s;
}

.tab.active {
  color: #222;
  font-weight: 600;
  font-size: 30rpx;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #222;
  border-radius: 4rpx;
}

/* Content Area */
.tab-content {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
}

.action-bar {
  margin-bottom: 24rpx;
  display: flex;
  justify-content: center;
}

.action-bar button {
  background: #fff;
  color: #333;
  font-size: 28rpx;
  padding: 18rpx 60rpx;
  border-radius: 100rpx; /* Pill shape */
  border: 1px solid #e0e0e0;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.03);
  font-weight: 500;
}

.action-bar button::after {
  border: none;
}

/* Manual Input Section */
.input-section {
  display: flex;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.url-input {
  flex: 1;
  background: #fff;
  height: 80rpx;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border: 1px solid #eee;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

.btn-add {
  height: 80rpx;
  line-height: 80rpx;
  background: #333;
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  margin: 0; 
}
.btn-add::after { border: none; } /* Remove default border */

/* List Items */
.list-scroll {
  flex: 1;
  overflow-y: auto;
}

.list-item {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.02);
}

.item-header {
  font-size: 22rpx;
  color: #aaa;
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.item-source {
  color: #667eea; /* Accent color */
  font-weight: 500;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.item-url {
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid #f9f9f9;
  padding-top: 20rpx;
  gap: 16rpx;
}

.btn-action {
  margin: 0 !important;
  font-size: 24rpx !important;
  padding: 10rpx 34rpx !important;
  border-radius: 100rpx !important; /* Full pill */
  font-weight: 500 !important;
  line-height: 1.5 !important;
  border: none !important;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.btn-action::after { border: none !important; }

.btn-generate {
  background: #333 !important;
  color: #fff !important;
}

.btn-delete {
  background: #fff !important;
  color: #999 !important;
  border: 1rpx solid #eee !important;
}

/* Pending Review Items */
.review-item {
  background: #fff;
  margin-bottom: 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.review-actions {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 30rpx;
  background: #fff;
  border-top: 1px solid #f9f9f9;
}

.review-actions button {
  flex: 1;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  padding: 20rpx 0;
  font-weight: 500;
}

.review-actions button::after {
  border: none;
}

.btn-approve {
  background: #333; /* Dark/Black for primary action */
  color: #fff;
}

.btn-reject {
  background: #f5f5f5;
  color: #999;
}

.empty-tip {
  text-align: center;
  color: #ccc;
  margin-top: 160rpx;
  font-size: 28rpx;
  font-weight: 300;
}
