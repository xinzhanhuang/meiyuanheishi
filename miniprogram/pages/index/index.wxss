/* Publish Popup Styles */
/* .publish-modal-bg & .publish-modal-content removed as page-container handles bg */

.publish-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.publish-options {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-top: 60rpx;
  margin-bottom: 50rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.publish-option-icon-bg {
  background-color: #ffffff;
  border-radius: 60rpx;
  width: 120rpx;
  height: 120rpx;
}

.publish-option-icon {
  width: 120rpx;
  height: 120rpx;
}

.publish-option-text {
  margin-top: 5rpx;
  text-align: center;
  color: #2139a3;
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 0; /* Reset previous margin */
}

.publish-close-btn {
  background-color: #ff7300;
  border-radius: 50%;
  width: 100rpx;
  height: 100rpx;
  margin-block-end: 50rpx; /* Add some bottom margin */
  margin-left: 0; /* Reset previous margin */
  transition: transform 0.3s;
}

.publish-close-icon {
  width: 100rpx;
  height: 100rpx;
}

/* Choosetitle Component Styles */
.choosetitle-container {
  width: 96%;
  margin: 10rpx auto;
  background-color: #fff;
  border-radius: 15rpx;
  padding: 20rpx 0 0 0;
  /* Hide if empty, though wx:if is better. Min-height ensures visibility if data exists */
  min-height: 150rpx; 
}

.choosetitle-scroll {
  white-space: nowrap;
  width: 100%;
  height: 150rpx; /* Ensure height */
}

.choosetitle-item {
  display: inline-block; /* Changed from inline-flex to inline-block */
  vertical-align: top;
  margin-right: 35rpx;
  width: 100rpx;
  text-align: center; /* Center content in inline-block */
}

.choosetitle-item:first-child {
  margin-left: 20rpx;
}

.choosetitle-item:last-child {
  margin-right: 20rpx;
}

.choosetitle-circle {
  width: 90rpx;
  height: 90rpx;
  background-color: #f0f0f0;
  border-radius: 30%;
  display: inline-flex; /* Flex inside the circle for centering */
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  margin-left: 5rpx; /* Center circle in 100rpx item */
}

.choosetitle-icon {
  font-size: 45rpx;
  line-height: normal; /* Reset line-height */
}

.choosetitle-text {
  display: block; /* Ensure text is on its own line */
  font-size: 20rpx;
  color: #333;
  text-align: center;
  width: 100%;
}