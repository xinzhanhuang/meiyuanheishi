@import "/styles/posts.wxss";

/* scroll-view 样式 */
.scroll-view_search {
  margin-top: 20rpx;
  width: 100%;
  height: 40px;
  white-space: nowrap;
}

/* scroll-item 样式 */
.scroll-item_search {
  display: inline-block;
  height: 50rpx;
  background-color: #f1f1f1;
  color: #656565;
  margin-right: 10px;
  text-align: center;
  font-size: 25rpx;
  border: 1px solid #ddd;
}


.container {
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: fixed;
  top: 0px;
  z-index: 990;
}

.search-group {
  width: 80%;
  height: 100%;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  background: #e3eef8;
  border-radius: 100rpx;
  padding: 0 15rpx;
}

.search-group>input {
  font-size: 25rpx;
  left: 14px;
}

.search-group>image {
  height: 50rpx;
  width: 50rpx;
  margin-right: 10rpx
}


.moveview {
  border-radius: 50rpx;
  pointer-events: auto;
  background-color: rgb(0, 38, 255);
  box-shadow: 0 4rpx 8rpx 0 rgba(0, 47, 255, 0.411);
}

.goTop {
  height: 100rpx;
  width: 100rpx;
  border-radius: 50%;
  opacity: 0.6;
}



.bankuai {
  /*整个板块的样式*/
  display: flex;
  justify-content: space-around;
}

.bankuainr {
  /*单个板块的样式*/
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 170rpx;
}

.bankuaiwenben {
  color: #656565;
  margin-top: 15rpx;
  font-size: 25rpx;
}

.slide_image {
  width: 100%;
  height: auto;
}

/* 轮播图 */
.swiper_wrapper {
  width: 100%;
  height: 100%
}

.container1 {
  display: flex;
  justify-content: flex-end;
  margin: 12rpx 17rpx;
  justify-content: flex-end;
  background-color: #b9b9b9;
  height: 180rpx;
}

.slide-image1 {
  width: 100%;
  height: 100%;
  /* 图片占满轮播图容器 */
}


/* 广告条 */
.broadcastbox {
  border-radius: 10rpx;
  width: 96.5%;
  display: flex;
  background-color: rgb(0, 0, 0);
  justify-content: space-between;
  margin: 15rpx 15rpx;
}

.broadcastList {
  width: 100%;
  height: 50rpx;
}

.broadcastListInde {
  font-size: 24rpx;
  display: flex;
  align-items: center;
  height: 50rpx;
}

.broadcastheadimgurl {
  width: 25rpx;
  height: 25rpx;
  border-radius: 50%;
  margin-left: 6rpx;
}

.broadcastContent {
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  white-space: nowrap;
  color: rgb(0, 255, 21);
}




/* 广告 */
