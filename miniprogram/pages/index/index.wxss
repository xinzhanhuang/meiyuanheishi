}




.body {
  background-color: var(--weui-BG-0);
}



/* 闪 特效 */
@keyframes blink {

  0%,
  100% {
    opacity: 0;
  }

  50% {
    opacity: 1;
  }
}



.blink-text {
  animation: blink 1.5s infinite;
  animation-delay: 0s, 0.8s;
  /* 通过延迟来实现闪烁效果 */
}

.blink-text:nth-child(2) {
  animation-delay: 0.5s, 0.9s;
  /* 不同元素的延迟时间稍有不同 */
}

