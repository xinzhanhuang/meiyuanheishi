.box {
  position: fixed;
  /* left: 0; */
  right: 0;
  z-index: 999;
  display: flex;
  justify-content: flex-end;
  align-items: flex-end;
  flex-direction: column;
  width: 680rpx;
}
.arrow {
  width: 0;
  height: 0;
  margin-right: 120rpx;
  border-width: 10px;
  border-style: solid;
  border-color:  transparent transparent #bfdffd transparent;
}
.body {
  background-color: #bfdffd;
  box-shadow: 0 10rpx 20rpx -10rpx #304f69;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 20rpx;
  margin-right: 40rpx;
}
.body > text {
  color: rgb(13, 53, 185);
  font-size: 28rpx;
  font-weight: 400;
}

