@import "/styles/posts.wxss";

.container {

  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  top: 0px;
  background: linear-gradient(#2651ae, #4687d4);
}

.kobai {
  height: 25rpx;
  color: rgb(255, 255, 255);
}

/* pages/select/select.wxss */
/* 遮罩 */
.modal-mask {

  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: rgb(0, 0, 0);
  opacity: 0.1;
  overflow: hidden;
  z-index: 151;
  color: #fff;
}


.timePicker {

  height: 20px;
  padding: 5px 10px;
  display: flex;
  margin-left: 160rpx;
  margin-top: 10rpx;
}

.box {
  position: absolute;
  z-index: 152;
  background-color: #5e5e5e;
  border-radius: 5rpx;
  box-shadow: 1px 1px 1px rgb(100, 100, 100);
  width: 215rpx;
  overflow: hidden;
}


.imagexx {
  width: 35rpx;
  height: 35rpx;
  margin-right: -20rpx;
}


.moveview {
  border-radius: 50rpx;
  position: relative;
  pointer-events: auto;
  background-color: rgb(0, 38, 255);
  box-shadow: 0 4rpx 8rpx 0 rgba(0, 47, 255, 0.411);

}

.goTop {
  height: 100rpx;
  width: 100rpx;
  border-radius: 50%;
  opacity: 0.6;
}

/* 搜索 放大镜 */

.fdj {
  width: 40rpx;
  height: 40rpx;

}

.search {
  justify-content: space-between;
  display: flex;


}

.search-wrap {
  display: flex;
  flex-direction: row;
  border: 1px solid#aaa;
  border-radius: 10px;
  height: 30px;
  align-items: center;
  margin: 10px;
  justify-content: space-between;
}


input {
  margin-left: 12px;
  width: 85%;
  font-size: 12px;
}

.custom-bar-wrapper {
  margin-left: 30rpx;
  position: absolute;
  color: rgb(218, 218, 218);
}

.title-container {
  color: rgb(255, 255, 255);
  font-size: 35rpx;
  font-weight: 500;
  width: 95%;
  margin-left: 20rpx;
}

.subtitle-text {
  font-weight: 400;
  font-size: 28rpx;
  margin-left: 20rpx;
  margin-top: 10rpx;
}

.action-bar-container {
  display: flex;
  justify-content: space-between;
  width: 96%;
}

.share-button {
  background-color: transparent;
  padding: 0;
  display: flex;
  align-items: center;
}

.share-icon {
  height: 45rpx;
  width: 45rpx;
}

.arrow-icon {
  transition: transform 0.3s;
}

.dropdown-box {
  transition: height 0.1s;
}

.dropdown-item {
  display: flex;
  margin-top: 20rpx;
}

.dropdown-text {
  margin-left: 25rpx;
  width: 200rpx;
  color: #ffffff;
  font-weight: 500;
  border-bottom: 1px solid gray;
}

.movable-area {
  width: 710rpx;
  position: fixed;
  top: 15rpx;
  left: 15rpx;
  pointer-events: none;
  z-index: 101;
}

.movable-view {
  height: 220rpx;
  width: 100rpx;
}

.posts-container {
  margin-top: 30rpx;
}

.modal-bg {
  background-color: #929292;
}

.modal-content {
  background-color: #e6f3ff;
}

.modal-options {
  overflow: hidden;
  display: flex;
  justify-content: space-between;
  width: 75%;
  margin-left: 13%;
  margin-top: 60rpx;
  margin-block-end: 50rpx;
}

.modal-option-icon-bg {
  background-color: #ffffff;
  border-radius: 60rpx;
  width: 120rpx;
  height: 120rpx;
}

.modal-option-icon {
  width: 120rpx;
  height: 120rpx;
}

.modal-option-text {
  margin-top: 10rpx;
  margin-left: 25%;
  color: #2139a3;
}

.modal-close-btn {
  background-color: #ff7300;
  border-radius: 100rpx;
  width: 100rpx;
  height: 100rpx;
  margin-left: 42%;
  transition: rotate 0.8s;
}

.modal-close-icon {
  width: 100rpx;
  height: 100rpx;
}