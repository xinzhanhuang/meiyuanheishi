<wxs module="tools" src="/utils/filter.wxs" />


<view class="del" catchtap="alldelete">全部已读</view>

<view wx:if="{{message.length>0}}">
  <view wx:for="{{message}}" wx:key="idex" wx:for-item="item0" wx:for-index="index0">
    <mp-slideview buttons="{{slideButtons}}" bindbuttontap="slideButtonTap" data-ssid="{{item0.ssid}}" data-id="{{item0.id}}" data-index="{{index0}}">
      <view class="content" bindtap="chakan" data-ssid="{{item0.ssid}}" data-id="{{item0.id}}" data-type="{{item0.type}}" data-liuyan="{{item0.liuyan}}" data-post-id="{{item0.postId}}" data-post-type="{{item0.postType}}" data-comment-id="{{item0.commentId}}" data-reply-id="{{item0.replyId}}" data-school-id="{{item0.schoolId}}">
        <view class="left">
          <!-- 第一部分图片 -->
          <view class="avatar-container">
            <image class="avatar" wx:if="{{item0.type!='jubao'&&item0.type!='jubaoplus'}}" src="{{item0.photo}}" />
            <!-- 举报特殊图标 -->
            <image class="avatar square" wx:if="{{item0.type=='jubao'||item0.type=='jubaoplus'}}" src="/images/icon/feng.png" />
          </view>
          <!-- 第二部分,回复及对应ss -->
          <view class="info-container">
            <view class="header-row">
              <view class="huifuren">{{item0.name}}</view>
              <view class="time">{{tools.timeChn.getDateTime(item0.time)}}</view>
            </view>
            

            <vier style="{{item0.isorder?'background-color:#f2f8ff;border-radius: 15rpx;padding: 10rpx;':''}}">
            <view class="action-row">
              <view class="wbnr" wx:if="{{item0.type==='pinglun'}}">{{item0.isorder?'订单':'帖子'}} 新评论</view>
              <view class="wbnr" wx:if="{{item0.type==='huifu'}}">{{item0.isorder?'订单':'帖子'}} 回复了你的评论</view>
              <view class="wbnr" wx:if="{{item0.type==='zhoubiantype'}}">{{tools.getZileiName(item0.zilei)}} {{item0.bhfpl?'回复了你的评论':'有条新评论'}}</view>
              <view class="wbnr" wx:if="{{item0.type==='jubao'}}">{{item0.isorder?'订单':'帖子'}}被举报封禁</view>
              <view class="wbnr" wx:if="{{item0.type==='jubaoplus'}}">{{item0.isorder?'订单':'帖子'}}被管理员封禁</view>
              <view class="wbnr" wx:if="{{item0.type==='Mazhupinglun'}}">马住{{item0.isorder?'订单':'帖子'}}新评论</view>
              <view class="wbnr" wx:if="{{item0.type==='takeorder'}}">接了你的订单</view>
              <view class="wbnr" wx:if="{{item0.type==='reject'}}" style="color:red">帖子审核不通过</view>
            </view>

            <view class="title" wx:if="{{item0.type!=='reject'}}">{{item0.plnr}}</view>
            <view class="title" wx:if="{{item0.type==='reject'}}">拒绝理由：{{item0.plnr}}</view>
            <view class="title" wx:if="{{item0.plnr==''}}">图片</view>


            <view class=" sub-title" wx:if="{{item0.type==='pinglun'}}">帖子：{{item0.ywnr}}</view>
            <view class=" sub-title" wx:if="{{item0.type==='huifu'}}">内容：{{item0.bhfpl}}</view>
            <view class=" sub-title" wx:if="{{item0.type==='zhoubiantype'}}">{{item0.bhfpl?'内容：'+item0.bhfpl:tools.getZileiName(item0.zilei)+'：'+item0.zbtitle}}</view>
            <view class=" sub-title" wx:if="{{item0.type==='Mazhupinglun'}}">帖子:{{item0.ywnr}}</view>
            <view class=" sub-title" wx:if="{{item0.type==='takeorder'}}">订单:{{item0.ywnr}}</view>
            <view class=" sub-title" wx:if="{{item0.type==='reject'}}">原帖：{{item0.zbtitle}}</view>
          </vier>
          </view>
        </view>
      </view>
    </mp-slideview>
  </view>
</view>


<view wx:else class="empty-tip">
  暂无回复</view>
