/* Global Styles */
page {
  background-color: #f5f7fa;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 20rpx;
  padding-bottom: 60rpx;
}

/* Card Styles */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
  padding: 24rpx;
  overflow: hidden;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #3498db;
  padding-left: 16rpx;
  line-height: 1.2;
}

/* Profile Card */
.profile-header {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  margin-right: 24rpx;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-right: 12rpx;
}

.vip-tag {
  background-color: #f1c40f;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.major {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 12rpx;
}

.status-row {
  display: flex;
  align-items: center;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.status-tag.online {
  background-color: #e8f8f5;
  color: #2ecc71;
}

.status-tag.offline {
  background-color: #f2f3f4;
  color: #95a5a6;
}

.phone {
  font-size: 24rpx;
  color: #3498db;
}

/* Stats Card */
.stats-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 4rpx;
}

.stat-value.violation {
  color: #e74c3c;
}

.stat-label {
  font-size: 24rpx;
  color: #95a5a6;
}

/* Management Card */
.action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.permission-status {
  display: flex;
  align-items: center;
}

.permission-status .label {
  font-size: 28rpx;
  color: #7f8c8d;
}

.permission-status .value {
  font-size: 28rpx;
  font-weight: 600;
  margin-left: 8rpx;
}

.permission-status .value.normal {
  color: #2ecc71;
}

.permission-status .value.banned {
  color: #e74c3c;
}

/* List Cards */
.list-content {
  display: flex;
  flex-direction: column;
}

.list-item {
  display: flex;
  align-items: center; /* Vertically align items */
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ecf0f1;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item.clickable:active {
  background-color: #f9f9f9;
}

.index {
  font-size: 24rpx;
  color: #bdc3c7;
  width: 40rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  text-align: center; /* Center the index number */
}

.item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center; /* Center content vertically */
  overflow: hidden;
  margin-right: 10rpx; /* Add some spacing before timestamp */
}

.content {
  font-size: 28rpx;
  color: #34495e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub-content {
  font-size: 24rpx;
  color: #95a5a6;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.timestamp {
  font-size: 22rpx;
  color: #bdc3c7;
  flex-shrink: 0;
}

.empty-tip {
  text-align: center;
  color: #bdc3c7;
  font-size: 26rpx;
  padding: 20rpx 0;
}