}

/* New extracted classes */
.user-info-container {
  display: flex;
  align-items: center;
  margin: 15rpx 0 15rpx 15rpx;
}

.user-details {
  display: flex;
  flex-direction: column;
}

.gender-icon {
  width: 30rpx;
  height: 30rpx;
}

.gender-icon-man {
  margin-top: 10rpx;
}

.gender-text-man {
  font-weight: 500;
  color: rgb(78, 101, 235);
}

.gender-text-woman {
