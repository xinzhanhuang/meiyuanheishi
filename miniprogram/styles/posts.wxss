/* Shared styles for post items */
.B {
  box-sizing: border-box;
  border-radius: 10rpx;
  width: 96%;
  margin-bottom: 30rpx;
  background-color: rgb(255, 255, 255);
  box-shadow: 0 4rpx 8rpx 0 rgba(0, 0, 0, .06);
  margin: 10rpx 30rpx;
  display: flex;
  justify-content: space-between;
  margin-left: 15rpx;
}

.B1 {
  width: 85rpx;
  background-color: #FFFFFF;
  height: 85rpx;
  margin: 35rpx 15rpx 0 20rpx;
}

.name {
  font-size: 90%;
  margin-top: 10rpx;
  color: #5566A3;
  font-weight: 600;
  margin-left: 8rpx;
}

.B22233 {
  /* 文本内容 */
  margin: 0rpx 40rpx 10rpx 10rpx;
  width: 550rpx;
  white-space: pre-line;
  word-break: break-all;
  word-wrap: break-word;
  font-size: 28rpx;
  color: rgb(77, 77, 77);
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal !important;
  -webkit-line-clamp: 4;
  /*  行数*/
  -webkit-box-orient: vertical;
}

.B22255 {
  /* 文本内容 */
  margin: 10rpx 10rpx -13rpx 20rpx;
  white-space: pre-line;
  word-break: break-all;
  word-wrap: break-word;
  font-size: 25rpx;
  font-weight: 500;
  color: rgb(221, 79, 79);
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal !important;
  -webkit-line-clamp: 1;
  /*  行数*/
  -webkit-box-orient: vertical;
}

.photo {
  width: 70rpx;
  border-radius: 120rpx;
  overflow: hidden;
  height: 70rpx;
}

.B2 {
  width: 100%;
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
}

.B21 {
  margin-top: 0%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.B23 {
  padding: 10rpx;
}

.B24 {
  display: flex;
  justify-content: space-between;
  padding: 0 10rpx;
  margin-top: 10rpx;
  margin-block-end: 10rpx;
}

.dzpl {
  display: flex;
}

.img2 {
  display: flex;
  flex-wrap: wrap;
}

/* User Info */
.user-name-container {
  justify-content: center;
  display: flex;
}

.gender-icon-text {
  font-weight: 500;
}

.gender-icon-female {
  color: rgb(255, 114, 59);
}

.gender-icon-male {
  color: rgb(94, 118, 255);
}

.gender-icon-img {
  width: 30rpx;
  height: 30rpx;
  margin-top: 8rpx;
}

/* Order Status */
.order-status-untaken {
  border-radius: 20rpx 0 0 20rpx;
  background-color: rgb(255, 167, 60);
  height: 55rpx;
  width: 100rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 500;
  display: flex;
}

.order-status-taken {
  border-radius: 20rpx 0 0 20rpx;
  background-color: rgb(221, 221, 221);
  height: 55rpx;
  width: 100rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 500;
  display: flex;
}

.order-status-text {
  margin: 7rpx 0 0 13rpx;
}

.activity-over-img {
  height: 250rpx;
  width: 250rpx;
  margin-left: 360rpx;
  margin-top: -20rpx;
  position: absolute;
  z-index: 1;
  opacity: 0.1;
}

.major-text {
  font-size: 20rpx;
  margin: -5rpx 0 20rpx 0;
  color: #929292;
  font-weight: 400;
  margin-left: 8rpx;
}

/* Order Detail */
.order-detail-box {
  width: 95%;
  background-color: #f2f8ff;
  border-radius: 15rpx;
}

.order-detail-header {
  font-size: 28rpx;
  font-weight: 500;
  justify-content: space-between;
  display: flex;
  margin: 15rpx 10rpx 25rpx 15rpx;
}

.order-location {
  margin-top: 3rpx;
}

.order-price {
  color: crimson;
  font-size: 30rpx;
  font-weight: 500;
}

.order-title {
  margin: 0 0 20rpx 15rpx;
  font-size: 28rpx;
  color: darkgrey;
}

/* Swiper & Content */
.post-swiper-img {
  width: 100%;
  height: 500rpx;
}

.post-content-text {
  text-align: justify;
}

.topic-tag {
  height: 60rpx;
  font-size: 28rpx;
  background-color: #d8ecff;
  font-weight: 900;
  border-radius: 10rpx;
  color: rgb(94, 118, 255);
}

.topic-hash {
  color: #d8ecff;
}

/* Images */
.single-img-container {
  width: 400rpx;
  margin-left: 4rpx;
  overflow: hidden;
  border-radius: 8rpx;
}

.single-img {
  height: 260rpx;
  width: auto;
  border-top: 0rpx;
  border-radius: 8rpx;
  border: 1px solid #ebebeb;
}

.loading-img-small {
  width: 250rpx;
  height: auto;

}

.multi-img-container {
  width: 100%;
  margin-left: 4rpx;
}

.multi-img-item {
  width: 170rpx;
  height: 170rpx;
}

.multi-img-item-4 {
  width: 200rpx;
  height: 200rpx;
}

.multi-img {
  width: 160rpx;
  height: 160rpx;
  margin-right: 8rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
  border: 1px solid #ebebeb;
}

.multi-img-4 {
  width: 190rpx;
  height: 190rpx;
  margin-right: 8rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
  border: 1px solid #ebebeb;
}

.grid-2x2 {
  width: 410rpx;
  /* 限制宽度，强制两张图片后换行 */
}

.loading-img-multi {
  width: 160rpx;
  height: 160rpx;
  margin-right: 8rpx;
  border-radius: 5rpx;
  margin-bottom: 8rpx;
}

.loading-img-multi-4 {
  width: 190rpx;
  height: 190rpx;
  margin-right: 8rpx;
  border-radius: 5rpx;
  margin-bottom: 8rpx;
}

/* Vote */
.vote-container {
  margin-top: 18rpx;
}



.vote-option-default {
  background: #f0f0f0;
}

.vote-text-container {
  position: absolute;
  display: flex;
  justify-content: space-between;
  margin-left: 50rpx;
  margin-top: 10rpx;
  width: 450rpx;
}

.vote-index {
  font-size: 25rpx;
  font-weight: 500;
}

.vote-content {
  color: #797979;
  font-size: 25rpx;
}

/* Comments */
.comment-container {
  margin: 20rpx;
}

.comment-item {
  display: flex;
}

.comment-content-container {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.comment-text-box {
  width: 520rpx;
  text-align: justify;
  font-size: 26rpx;
}

.hot-comment-icon {
  width: 35rpx;
  height: 40rpx;
  margin-block-end: -10rpx;
}

.hot-comment-text {
  color: #ff7300;
  font-size: 25rpx;
  font-weight: 800;
  font-style: oblique;
}

.comment-user {
  color: #0037ff;
}

.comment-img-tag {
  white-space: nowrap;
  padding: 0 10rpx 0 10rpx;
  color: #0037ff;
  font-weight: 600;
  font-size: 23rpx;
  border-radius: 10rpx;
  border: 1px solid #0037ff;
}

.comment-content {
  color: #5566A3;
  text-align: justify;
}

/* Action Bar */
.time-text {
  font-weight: 400;
  font-size: 70%;
  color: #929292;
  margin-left: 4rpx;
}

.action-bar {
  margin-right: 20rpx;
  display: flex;
}

.action-item {
  display: flex;
}

.action-icon {
  width: 30rpx;
  height: 30rpx;
}

.action-icon-margin {
  margin-left: 10rpx;
  width: 30rpx;
  height: 30rpx;
}

.action-count {
  font-size: 78%;
  color: #656565;
  font-weight: lighter;
  margin-right: 10rpx;
}

.bottom-loading {
  text-align: center;
}

.bottom-loading-img {
  width: 40rpx;
  height: auto;
  margin-top: 30rpx;
}

.zhankai {
  border-radius: 10rpx;
  width: 95%;
  background-color: rgb(235, 235, 235);
  margin: 10rpx 0 20rpx 0;
  font-size: 80%;
  color: #5566A3;
  font-weight: 500;
}

.option {
  height: 70rpx;
  width: 550rpx;
  margin-block-end: 20rpx;
  border-width: 0rpx;
  border-radius: 50rpx;
  overflow: hidden;
}
